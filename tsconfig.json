{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@uet/core": ["packages/core/src/index.ts"],
      "@uet/engine": ["packages/engine/src/index.ts"],
      "@uet/host-ae": ["packages/host-ae/src/index.ts"],
      "@uet/host-ppro": ["packages/host-ppro/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "tests", "tools"]
}
